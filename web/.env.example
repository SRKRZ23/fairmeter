# Copy to web/.env.local (never commit it). Vercel: set the same names in Project Settings -> Environment Variables.

# Which networks the app offers, comma-separated; the first is the default.
#   aevum = QDay Aevum testnet (44005) · fork = `make fork` (440050) · local = `make anvil` (31337)
NEXT_PUBLIC_NETWORKS=aevum

# FairMeter on each network (printed by `make deploy-aevum` / `deploy-fork` / `deploy-local`).
NEXT_PUBLIC_FAIRMETER_AEVUM=0x347bB333a61B804C27B17a949fE763b4BA572380
NEXT_PUBLIC_FAIRMETER_FORK=
# Optional: scan events from this block (FairMeter's deploy block) instead of the last 20k blocks.
NEXT_PUBLIC_DEPLOY_BLOCK_AEVUM=3635646
NEXT_PUBLIC_DEPLOY_BLOCK_FORK=

# Optional. WalletConnect (mobile wallets via QR). Free at https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=
# Optional. Where the header's GitHub link points.
NEXT_PUBLIC_REPO_URL=

# ---- Server only (never sent to the browser) ----

# The provider's settlement key: a TEST wallet with a little tQDAY. It settles charges and pays gas for
# gasless mandate opening. Its address is the provider every mandate must name.
PROVIDER_PRIVATE_KEY=
# 32-byte hex seed of the provider's ML-DSA-65 receipt key. Publish the key once: `pnpm example publish-pq-key`.
#   openssl rand -hex 32
PQ_SEED=
# 32-byte hex secret that binds quotes to request ids (keeps the gateway stateless).   openssl rand -hex 32
QUOTE_SECRET=
# Model provider (Groq, OpenAI-compatible). Free tier works: https://console.groq.com
GROQ_API_KEY=

# Optional. Header your host sets with the real client IP, for rate limits. Vercel: x-vercel-forwarded-for
# TRUSTED_IP_HEADER=
